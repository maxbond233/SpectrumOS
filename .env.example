# LLM — Claude via 4SAPI (OpenAI-compatible)
CLAUDE_API_KEY=sk-xxx
CLAUDE_BASE_URL=https://4sapi.com/v1
# LLM — DeepSeek via 4SAPI
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://4sapi.com/v1
# Web search
TAVILY_API_KEY=tvly-xxx

# v0.5.0 本机运行配置
SPECTRUM_MODEL=claude-sonnet-4-5-20250929
SPECTRUM_DATABASE_URL=postgresql+psycopg://spectrum:spectrum@127.0.0.1:55432/spectrum
SPECTRUM_REDIS_URL=redis://127.0.0.1:56379/0
SPECTRUM_S3_ENDPOINT=http://127.0.0.1:59000
SPECTRUM_S3_ACCESS_KEY=spectrum
SPECTRUM_S3_SECRET_KEY=spectrum-local-storage
# 容器部署时必须配置；Next.js 和 API 使用相同值
SPECTRUM_API_TOKEN=
# 按实际服务合同配置 Token 单价，单位为美元/百万 Token
SPECTRUM_INPUT_PRICE_PER_MILLION=3
SPECTRUM_OUTPUT_PRICE_PER_MILLION=15
